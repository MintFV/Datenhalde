
.vscode

## always keep these files and folders
!**/.gitignore
!**/.gitattributes
!**/.dockerignore
!**/.gitkeep

## config files, sensitive data
**/.env
**/.env.*
!env.*

## nginx files
nginx/logs/*
!nginx/logs/.gitkeep
nginx/conf/default.conf
nginx/conf/ssl.conf
nginx/conf/*.disabled

## certbot files
certbot/conf/.initialized
certbot/conf/archive/*
!certbot/conf/archive/README.md
certbot/conf/live/
certbot/conf/renewal/
certbot/conf/accounts/
certbot/logs/*
!certbot/logs/.gitkeep
certbot/www/.well-known/
!certbot/www/.well-known/.gitkeep


## mosquitto data and logs
mosquitto/data/*
!mosquitto/data/.gitkeep
mosquitto/logs/*
!mosquitto/logs/.gitkeep
mosquitto/config/mosquitto.passwd
mosquitto/config/mosquitto.acl


## influxdb data and sensitive tokens
influxdb/data/
influxdb/tokens/
influxdb/plugins/
!influxdb/plugins/.gitkeep


## grafana data
grafana/data/*.db
grafana/data/grafana.db        # NEU: Explizit (SQLite DB)
grafana/data/plugins/          # NEU: Installierte Plugins
grafana/data/png/              # NEU: Screenshot Cache
grafana/data/sessions/         # NEU: User Sessions
grafana/data/csv/              # NEU: CSV Exports
!grafana/data/.gitkeep


## nodered auf jeden Fall mit aufnehmen im GIT
!nodered/data/settings.js
!nodered/data/flows_*.json
!nodered/data/flows.json
!nodered/data/settings.js
!nodered/data/package.json
!nodered/data/package-lock.js
!nodered/data/lib/flows/

## nodered data and npm cache
nodered/data/flows_cred.json
nodered/data/context/
nodered/data/node_modules/
nodered/data/.npm/
nodered/data/settings.js.*
nodered/data/.config.*.json*
nodered/data/.sessions.json
nodered/data/*.backup



## SMTP-Relay / Exim
smtp-relay/spool

################################################################################
## backup files
*.tar.gz                       # NEU: Backup Archives
*.backup                       # NEU: Backup Dateien
*.bak                          # NEU: Backup Dateien
*-backup-*.tar.gz              # NEU: Timestamped Backups

## OS files
.DS_Store                      # NEU: macOS
Thumbs.db                      # NEU: Windows
desktop.ini                    # NEU: Windows
.directory                     # NEU: KDE

## IDE files
.vscode/*                      # NEU: VS Code (außer settings)
!.vscode/settings.json
.idea/*                        # NEU: IntelliJ
*.swp                          # NEU: Vim
*.swo                          # NEU: Vim
*~                             # NEU: Emacs

## Docker
.env.generated                 # NEU: Falls generiert aus config.yaml

## Temporary files
tmp/
*.tmp                          # NEU: Temp Files
*.log                          # NEU: Log Files (generell)

## Documentation backups (keep docs themselves!)
*.md.backup
*.md.bak
*.md.[0-9]*

## Runtime Daten
selfservice/data/*
*.db

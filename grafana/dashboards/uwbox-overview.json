          "format": "time_series",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\n  time,\n  value,\n  CONCAT(device_id, ' / ', sensor_type) AS displayoverride\nFROM sensors\nWHERE\n  device_id ILIKE 'uwbox%'\n  AND $__timeFilter(time)\nORDER BY time ASC;",

# Node-RED Environment Variables for MintFV
#
# WICHTIG: Kopiere diese Datei zu .env und fülle deine echten Werte ein!
# Die .env-Datei ist in .gitignore und wird NICHT ins Git committed!

# ============================================
# Node-RED Admin Credentials
# ============================================

# Admin Username
NODE_RED_ADMIN_USER=admin

# Admin Password Hash (NICHT das Passwort selbst!)
# Generiere den Hash:
#   docker exec -it mintfv-nodered npx node-red admin hash-pw
# Gib dein Passwort ein, kopiere den Hash hierher
NODE_RED_ADMIN_PASSWORD_HASH='$2yyyyyyyyyyyyyyyyyyyyyzzzzzzzzzzzzzzzzxxxxxxxxxxxxxxxxxxxxx'

# ============================================
# Flow Credential Encryption
# ============================================

# Credential Secret (32 Byte Hex String)
# WICHTIG: Ändere diesen Wert NIEMALS nach dem ersten Start!
# Sonst können bestehende Credentials nicht mehr entschlüsselt werden!
#
# Generiere neuen Key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# AKTUELLER KEY (aus deiner settings.js):
NODE_RED_CREDENTIAL_SECRET='xxxxxxxxxxxxxxxxxxxxxxxxxyyyyyyyyyyyyyyyyyyyyyyyyyzzzzzzzzzzzzzz'


# ============================================================================
# MintFV Deployment Configuration
# Kopiere diese Datei zu .env und passe deine Werte an!
# Die .env wird NICHT ins Git committed (siehe .gitignore)
# ============================================================================

# ============================================================================
# 1. DOMAIN & EMAIL (für Let's Encrypt SSL)
# ============================================================================

# Deine öffentliche Domain (muss via DNS auf diesen Server zeigen)
DOMAIN=mintfv.example.com

# Email für Let's Encrypt Benachrichtigungen
EMAIL=your-email@example.com

# ============================================================================
# 2. LET'S ENCRYPT CONFIGURATION
# ============================================================================

# Automatische Zertifikat-Erneuerung
# Optionen: 12h (empfohlen), 24h, 7d, 30d
RENEWAL_INTERVAL=12h

# ============================================================================
# 3. TIMEZONE
# ============================================================================

# Zeitzone für alle Container
# Liste: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Berlin

# (Optional) Nginx Host/Port Overrides (meist nicht nötig)
# NGINX_HOST=localhost
# NGINX_PORT=8080

# ============================================================================
# 4. NODE-RED CREDENTIALS
# ============================================================================

# Admin Username (optional, default: adminnodered)
# Wenn nicht gesetzt, wird adminnodered verwendet
# NODE_RED_ADMIN_USER=adminnodered

# Admin Password Hash (NICHT das Passwort selbst!)
# Generiere: docker compose exec nodered node -e "console.log(require('bcryptjs').hashSync('your-password', 8));"
# Generierten String in NODE_RED_ADMIN_PASSWORD_HASH einfügen
# docker compose restart nodered
NODE_RED_ADMIN_PASSWORD_HASH='$2y$08$changeme_with_real_hash_value'

# Credential Secret (32 Byte Hex String)
# WICHTIG: Ändere diesen Wert NIEMALS nach dem ersten Start!
# Generiere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_RED_CREDENTIAL_SECRET='changeme_with_32byte_hex_string'

# ============================================================================
# 5. GRAFANA CREDENTIALS
# ============================================================================

# Admin Username (optional, default: admingrafana)
# Wenn nicht gesetzt, wird admingrafana verwendet
# GRAFANA_ADMIN_USER=admingrafana

# Admin Password
# ⚠️ Bitte für Production ändern!
# Generiere sicheres Passwort: openssl rand -base64 32
GRAFANA_ADMIN_PASSWORD=changeme

# Grafana Basis-URL (mit Sub-Path /grafana/)
GRAFANA_SERVER_ROOT_URL=https://mintfv.example.com/grafana/

# ============================================================================
# 6. SMTP Relay Credentials
# ============================================================================

# SMTP-Anmeldedaten für den externen Smarthost (z.B. IONOS)
SMTP_USER_PROVIDER=your-smtp-user
SMTP_PASS_PROVIDER=your-smtp-password
# SMTP_DOMAIN=mintfv.peddy.net # siehe oben DOMAIN

# ============================================================================
# 7. SELFSERVICE-PORTAL
# ============================================================================

# Geheimer Schlüssel für Session-Cookies und Token-Signierung
# Generiere: python3 -c "import secrets; print(secrets.token_hex(32))"
SELFSERVICE_SECRET_KEY=changeme_with_64char_hex_string

# ============================================================================
# HINWEIS: InfluxDB Admin Token
# ============================================================================
# Der InfluxDB Admin Token wird automatisch beim ersten Start generiert
# und in ./influxdb/tokens/admin.token gespeichert (JSON-Format).
# Auslesen mit: cat ./influxdb/tokens/admin.token | jq -r '.token'
# ============================================================================

# ============================================================================
# HINWEIS: Demo-Zugangsdaten (MQTT, Grafana, Node-RED)
# ============================================================================
# Demo-Zugangsdaten für Tests sind in den Service-READMEs dokumentiert:
# - mosquitto/README.md - MQTT Multi-Tenant Credentials
# - grafana/README.md - Grafana Admin Login
# - nodered/README.md - Node-RED Admin Setup
# ============================================================================



# ============================================================================
# MintFV Multi-Tenant ACL Configuration - EXAMPLE
# ============================================================================
#
# WICHTIGE HINWEISE:
#
# 1. ACL-VALIDIERUNG NUR ÜBER BROKER-LOGS!
#    - Client-Return-Codes (QoS 0) zeigen IMMER SUCCESS
#    - Auch wenn Broker die Nachricht per ACL blockiert!
#    - Validierung: docker compose logs -f mosquitto | grep "Denied"
#
# 2. MOSQUITTO HAT DEFAULT-DENY
#    - Alles was nicht explizit erlaubt ist, wird blockiert
#    - NIEMALS "topic deny #" verwenden! (blockiert nachfolgende allow-Regeln)
#
# 3. SYNTAX-REGELN
#    - Wildcards: # (multi-level), + (single-level)
#    - Reihenfolge: "user" Zeile MUSS vor "topic" Zeilen kommen
#    - Keine führenden Leerzeichen/Tabs vor "topic"
#    - pattern vs topic: Verwende "topic" (sicherer, siehe CVE-2017-7650)
#
# 4. TESTING
#    - Automatisiert: ./test-acl.sh --verbose
#    - Manuell: Siehe MOSQUITTO.md - "ACL Testing & Validation"
#    - Troubleshooting: Siehe TROUBLESHOOTING-ACL.md
#
# 5. VERWENDUNG
#    cp mosquitto.acl.example mosquitto.acl
#    chmod 640 mosquitto.acl
#    chgrp 2100 mosquitto.acl
#    docker compose restart mosquitto
#
# ============================================================================

# ============================================================================
# HEALTHCHECK (benötigt für Docker Healthcheck) - MUSS ZUERST KOMMEN!
# ============================================================================
user healthcheck
topic read $SYS/#

# ============================================================================
# MASTER TENANT - Vollzugriff auf alles
# ============================================================================
user master-admin
topic readwrite #

# ============================================================================
# TENANT A - Firma Alpha GmbH
# ============================================================================

# Tenant Admin (kann alles in seinem Tenant lesen/schreiben)
user tenant-a-admin
topic readwrite tenant/tenant-a/#
topic read $SYS/#

# Sensoren (können beliebige Topics im Tenant schreiben)
user tenant-a-sensor01
topic write tenant/tenant-a/#
topic read tenant/tenant-a/commands/sensor01/#
topic read $SYS/broker/version

user tenant-a-sensor02
topic write tenant/tenant-a/#
topic read tenant/tenant-a/commands/sensor02/#
topic read $SYS/broker/version

# Node-RED für Tenant (verarbeitet alle Tenant-Daten)
user tenant-a-nodered
topic readwrite tenant/tenant-a/#
topic read $SYS/#

# ============================================================================
# TENANT B - Stadt Beta
# ============================================================================

user tenant-b-admin
topic readwrite tenant/tenant-b/#
topic read $SYS/#

user tenant-b-sensor01
topic write tenant/tenant-b/#
topic read tenant/tenant-b/commands/sensor01/#
topic read $SYS/broker/version

user tenant-b-sensor02
topic write tenant/tenant-b/#
topic read tenant/tenant-b/commands/sensor02/#
topic read $SYS/broker/version

user tenant-b-nodered
topic readwrite tenant/tenant-b/#
topic read $SYS/#

# ============================================================================
# TENANT C - Umwelt Gamma e.V.
# ============================================================================

user tenant-c-admin
topic readwrite tenant/tenant-c/#
topic read $SYS/#

user tenant-c-sensor01
topic write tenant/tenant-c/#
topic read tenant/tenant-c/commands/sensor01/#
topic read $SYS/broker/version

user tenant-c-sensor02
topic write tenant/tenant-c/#
topic read tenant/tenant-c/commands/sensor02/#
topic read $SYS/broker/version

user tenant-c-nodered
topic readwrite tenant/tenant-c/#
topic read $SYS/#

# ============================================================================
# TENANT D - Realschule Köln (umweltbox-Format nach 03_MQTT_Topic_Struktur.md)
# umweltbox/{tenant-id}/{device-id}/{category}/{measurement}
# {land}-{bundesland}-{schultyp}-{schulname}[-{einheit}]
# ============================================================================

# Tenant Admin (kann alles in seinem Tenant lesen/schreiben)
user de-nrw-rs-koeln-admin
topic readwrite umweltbox/de-nrw-rs-koeln/#
topic read $SYS/#

# Sensoren (können beliebige Topics im Tenant schreiben)
user de-nrw-rs-koeln-sensor01
topic write umweltbox/de-nrw-rs-koeln/#
topic read umweltbox/de-nrw-rs-koeln/commands/sensor01/#
topic read $SYS/broker/version

user de-nrw-rs-koeln-sensor02
topic write umweltbox/de-nrw-rs-koeln/#
topic read umweltbox/de-nrw-rs-koeln/commands/sensor02/#
topic read $SYS/broker/version

# Node-RED für Tenant (verarbeitet alle Tenant-Daten)
user de-nrw-rs-koeln-nodered
topic readwrite umweltbox/de-nrw-rs-koeln/#
topic read $SYS/#

# ============================================================================
# TENANT E - Arbeitsgruppe Klima Berlin (umweltbox-Format nach 03_MQTT_Topic_Struktur.md)
# ============================================================================

# Tenant Admin (kann alles in seinem Tenant lesen/schreiben)
user de-be-ag-klima-admin
topic readwrite umweltbox/de-be-ag-klima/#
topic read $SYS/#

# Sensoren (können beliebige Topics im Tenant schreiben)
user de-be-ag-klima-sensor01
topic write umweltbox/de-be-ag-klima/#
topic read umweltbox/de-be-ag-klima/commands/sensor01/#
topic read $SYS/broker/version

user de-be-ag-klima-sensor02
topic write umweltbox/de-be-ag-klima/#
topic read umweltbox/de-be-ag-klima/commands/sensor02/#
topic read $SYS/broker/version

# Node-RED für Tenant (verarbeitet alle Tenant-Daten)
user de-be-ag-klima-nodered
topic readwrite umweltbox/de-be-ag-klima/#
topic read $SYS/#

# ============================================================================
# TENANT Z - für eine Privatperson (umweltbox-Format nach 03_MQTT_Topic_Struktur.md)
# umweltbox/{tenant-id}/{device-id}/{category}/{measurement}
# {land}-{bundesland}-{schultyp}-{schulname}[-{einheit}]
# ============================================================================

# Tenant Admin (kann alles in seinem Tenant lesen/schreiben)
user de-hh-privat-peddy-admin
topic readwrite umweltbox/de-hh-privat-peddy/#
topic read $SYS/#

# Sensoren (können beliebige Topics im Tenant schreiben)
user de-hh-privat-peddy-raspi4
topic write umweltbox/de-hh-privat-peddy/#
topic read umweltbox/de-hh-privat-peddy/commands/raspi4/#
topic read $SYS/broker/version

user de-hh-privat-peddy-raspi2
topic write umweltbox/de-hh-privat-peddy/#
topic read umweltbox/de-hh-privat-peddy/commands/raspi2/#
topic read $SYS/broker/version

# Node-RED für Tenant (verarbeitet alle Tenant-Daten)
user de-hh-privat-peddy-nodered
topic readwrite umweltbox/de-hh-privat-peddy/#
topic read $SYS/#

# ============================================================================
# Abschnitt für Privatpersonen
#   damit der Zugriff einfach ist, sollen Privatpersonen auf ihren kompletten
#   "Zweig" volle Berechtigung haben, Muster ist:
#   umweltbox/{land}-{bundesland}-privat-{username of private person}
# ============================================================================

# peddy - Maintainer der MQTT-Umweltbox
user de-hh-privat-peddy
topic write umweltbox/de-hh-privat-peddy/#
topic read  umweltbox/de-hh-privat-peddy/#
topic read $SYS/broker/version

# Julien - Mintarium offene Werkstatt
user de-hh-privat-julien
topic write umweltbox/de-hh-privat-julien/#
topic read  umweltbox/de-hh-privat-julien/#
topic read $SYS/broker/version

# Sebastian - Mintarium offene Werkstatt
user de-sh-privat-sebo
topic write umweltbox/de-sh-privat-sebo/#
topic read  umweltbox/de-sh-privat-sebo/#
topic read $SYS/broker/version

# ============================================================================
# MONITORING USER (optional - read-only für Systemüberwachung)
# ============================================================================
user monitoring
topic read $SYS/#
topic read tenant/+/+/status

# ============================================================================
# HINWEISE & BEST PRACTICES
# ============================================================================
#
# ❌ HÄUFIGE FEHLER:
#
# 1. "topic deny #" verwenden:
#    user sensor01
#    topic deny #           # ← FALSCH! Blockiert ALLES!
#    topic write sensors/#  # ← Hat keine Wirkung mehr
#
#    Richtig:
#    user sensor01
#    topic write sensors/#  # Alles andere automatisch denied!
#
# 2. Falsche Wildcards:
#    topic write sensors/*  # ← FALSCH! * gibt es nicht in MQTT
#    topic write sensors/#  # ← RICHTIG!
#
# 3. Permissions vergessen:
#    chmod 600 mosquitto.acl  # ← Zu restriktiv
#    chmod 640 mosquitto.acl  # ← RICHTIG! (Group 2100 muss lesen können)
#
# 4. Topic-Namespace Kollisionen:
#    user tenant-a-sensor01
#    topic write sensors/01/#  # ← KONFLIKT mit Tenant B!
#
#    Richtig:
#    topic write tenant/tenant-a/sensor01/#  # ← Namespace-Isolation
#
# ============================================================================
# TESTING
# ============================================================================
#
# Nach jeder Änderung TESTEN:
#
#   ./test-acl.sh --verbose
#
# Oder manuell:
#
#   # Terminal 1: Logs
#   docker compose logs -f mosquitto | grep -E "(Received|Denied)"
#
#   # Terminal 2: Test
#   mosquitto_pub -u tenant-a-sensor01 -P sensor01 \
#     -t "tenant/tenant-b/hack" -m "test"
#
#   # Terminal 1 sollte zeigen:
#   # Denied PUBLISH from tenant-a-sensor01  ✓ ACL funktioniert!
#
# ============================================================================
